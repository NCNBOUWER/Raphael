{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romer.industries/schemas/ecox-opc/mission.schema.json",
  "title": "EcoX OPC Mission Object",
  "type": "object",
  "required": ["mission_id", "project_id", "name", "mission_type", "region", "required_capabilities", "safety_state", "bid_state", "decision_state", "status"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^MSN-[0-9]{4,}$"},
    "project_id": {"const": "ECOX-OPC-0001"},
    "cluster_id": {"type": ["string", "null"]},
    "name": {"type": "string"},
    "mission_type": {"type": "string"},
    "region": {"type": "string"},
    "window_start": {"type": ["string", "null"], "format": "date-time"},
    "window_end": {"type": ["string", "null"], "format": "date-time"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "priority_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "safety_state": {"enum": ["Clear", "Review", "Hold", "Paused"]},
    "bid_state": {"enum": ["Open", "Watching", "Bid Submitted", "Shortlisted", "Awarded", "Declined", "Closed"]},
    "decision_state": {"type": "string"},
    "awarded_node_ids": {"type": "array", "items": {"type": "string"}},
    "economics": {
      "type": "object",
      "properties": {
        "gross_value": {"type": ["number", "null"]},
        "direct_cost": {"type": ["number", "null"]},
        "operator_share_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "perpetuation_share_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "status": {"type": "string"},
    "evidence_links": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
