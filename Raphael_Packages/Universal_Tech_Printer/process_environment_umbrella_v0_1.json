    },
    {
      "id": "PF-MECH-INSTALL",
      "name": "precision insert / mechanism",
      "functions": [
        "bearing",
        "shaft",
        "seal",
        "gear",
        "spring",
        "motor rotor/stator insert",
        "sensor die"
      ],
      "tools": [
        "pick-place",
        "press-fit tool",
        "mill"
      ],
      "typical_environments": [
        "ENV-AIR",
        "ENV-DRY-INERT"
      ],
      "priority": "install after incompatible thermal/chemical steps"
    }
  ],
  "environments": [
    {
      "id": "ENV-AIR",
      "name": "ambient/dry air",
      "cost": "low",
      "best_for": [
        "structural print",
        "machining",
        "inspection",
        "many polymers/ceramics"
      ],
      "avoid": [
        "oxygen/moisture-sensitive chemistry",
        "expensive gas discharge fill"
      ]
    },
    {
      "id": "ENV-DRY-INERT",
      "name": "dry nitrogen or argon near ambient pressure",
      "cost": "low-moderate",
      "best_for": [
        "oxidation-sensitive conductors",
        "dry assembly",
        "many functional inks",
        "electrochemical dry assembly"
      ],
      "sensors": [
        "O2",
        "H2O/dew point",
        "pressure"
      ]
    },
    {
      "id": "ENV-REDUCED-P",
      "name": "reduced pressure / rough vacuum",
      "cost": "moderate",
      "best_for": [
        "degassing",
        "void control",
        "gas exchange",
        "vacuum gaps",
        "specialist deposition submodules"
      ],
      "rule": "pressure range is process-specific; do not treat one vacuum level as universal"
    },
    {
      "id": "ENV-LOCAL-SHROUD",
      "name": "tool-local controlled microclimate",
      "cost": "moderate",
      "best_for": [
        "small-volume inert/solvent/process zones",
        "protecting existing object from global chamber change"
      ]
    },
    {
      "id": "ENV-NOBLE-LOCAL",
      "name": "local noble-gas fill/recovery",
      "cost": "high gas / low volume preferred",
      "best_for": [
        "sealed plasma/discharge cells"
      ],
      "reference_only": "PDP literature contains Ne/Xe sub-atmospheric examples; UTP recipe remains device-test specific"
    },
    {
      "id": "ENV-WET-LOCAL",
      "name": "isolated wet/electrochemical microcell",
      "cost": "moderate",
      "best_for": [
        "electrolyte placement",
        "electrodeposition",
        "wet chemistry"
      ],
      "rule": "physically isolated from general chamber/vacuum train where contamination is unacceptable"
    },
    {
      "id": "ENV-ENERGY",
      "name": "energy-treatment overlay",
      "cost": "tool-dependent",
      "best_for": [
        "UV cure",
        "IR/thermal cure",
        "photonic flash",
        "localized laser",
        "Joule conditioning",
        "mechanical strain programming"
      ],
      "rule": "overlay on another environment; it is not a gas state"
    }
  ],
  "overlap_logic": [
    "PF-STRUCT, PF-COND, PF-DIEL, PF-FUNC and most PF-PASSIVE share ENV-AIR/ENV-DRY-INERT and therefore form the highest-value common core",
    "PF-OPT usually shares the same common core plus UV/photonic treatment",
    "PF-CAV requires the common core to create geometry, then a late fill/evacuate/seal operation",
    "PF-PLASMA and PF-ELECTROCHEM should be activated late because their gas/electrolyte contents are vulnerable to subsequent heat/vacuum/chemical processing",
    "PF-ACTIVE-HYBRID provides most computer functionality without forcing the printer to reproduce a semiconductor fab",
    "PF-SEMIPRINT is a specialist branch that can rationally reuse motion, chamber, fine deposition and energy subsystems without claiming literal CMOS process equivalence"
  ]
}