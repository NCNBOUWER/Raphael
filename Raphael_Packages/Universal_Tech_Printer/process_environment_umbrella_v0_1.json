{
  "artifact_id": "UTP-UMBRELLA-001",
  "version": "0.1",
  "date": "2026-10-06",
  "title": "Universal Printer Umbrella Process / Environment Families",
  "process_families": [
    {
      "id": "PF-STRUCT",
      "name": "structural skeleton and enclosure",
      "functions": [
        "load path",
        "fixture",
        "cavity wall",
        "rib",
        "lattice",
        "housing",
        "service channel"
      ],
      "tools": [
        "pellet/filament/paste extrusion",
        "optional wire/metal deposition",
        "mill"
      ],
      "typical_environments": [
        "ENV-AIR",
        "ENV-DRY-INERT"
      ],
      "priority": "early/high-temperature first"
    },
    {
      "id": "PF-COND",
      "name": "electrical conductor / bus / electrode",
      "functions": [
        "power",
        "signal",
        "coil",
        "heater",
        "electrode",
        "ground plane",
        "shield"
      ],
      "tools": [
        "DIW/microdispense",
        "wire embed",
        "electrodeposition optional",
        "mill/laser trim"
      ],
      "typical_environments": [
        "ENV-AIR",
        "ENV-DRY-INERT"
      ],
      "postprocess": [
        "thermal cure",
        "photonic cure",
        "laser/local sinter as qualified"
      ]
    },
    {
      "id": "PF-DIEL",
