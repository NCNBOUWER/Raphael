        "dielectric print",
        "phosphor print",
        "local gas fill",
        "seal"
      ],
      "typical_environments": [
        "ENV-NOBLE-LOCAL"
      ],
      "rule": "gas creates discharge/UV; visible RGB normally selected by phosphor/conversion layer, not separate RGB gas chemistry"
    },
    {
      "id": "PF-PASSIVE",
      "name": "printed passive electronics",
      "functions": [
        "resistor",
        "heater",
        "capacitor",
        "inductor",
        "antenna",
        "crossovers"
      ],
      "tools": [
