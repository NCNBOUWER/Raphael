        "ENV-AIR",
        "ENV-DRY-INERT",
        "ENV-LOCAL-SHROUD"
      ]
    },
    {
      "id": "PF-CAV",
      "name": "printed cavity / void / channel",
      "functions": [
        "vacuum gap",
        "gas cell",
        "fluid channel",
        "thermal break",
        "acoustic resonator",
        "service void"
      ],
      "tools": [
        "skeleton extrusion",
        "sacrificial/support process",
