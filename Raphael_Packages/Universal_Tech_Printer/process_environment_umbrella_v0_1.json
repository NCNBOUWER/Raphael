        "encapsulation"
      ],
      "tools": [
        "DIW",
        "extrusion",
        "coating"
      ],
      "typical_environments": [
        "ENV-AIR",
        "ENV-DRY-INERT"
      ],
      "postprocess": [
        "UV",
        "thermal",
        "photonic where compatible"
      ]
    },
    {
      "id": "PF-FUNC",
      "name": "functional composite",
      "functions": [
        "resistive",
