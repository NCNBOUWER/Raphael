    },
    {
      "order": 2,
      "node": "RESOURCE_FRONT_END",
      "role": "capture/excavate, classify, magnetic/electrostatic/RFS/EMFF candidate beneficiation, dust control"
    },
    {
      "order": 3,
      "node": "REFINERY",
      "role": "extract metals, silicon/mineral/glass fractions, oxygen/volatiles; assay and stock"
    },
    {
      "order": 4,
      "node": "FEED_FORMULATION",
      "role": "convert local bulk + recycled stock + carried specialty concentrates into printer-qualified feed passports"
    },
    {
      "order": 5,
      "node": "ROAMING_AGENTS",
      "role": "mobile/tethered local-environment printers for structures exceeding chamber envelope"
    },
    {
      "order": 6,
      "node": "MARK_LUKE_INFRASTRUCTURE",
      "role": "fabricate/repair mission hardware and larger infrastructure from common functional primitives"
    }
  ],
  "bootstrap_priority": [
    "reproduce printer capability first",
    "increase power generation/distribution",
    "increase resource throughput/stock diversity",
    "increase mobility and cooperative carry capacity",
    "then scale Mark/Luke/end-use infrastructure"
